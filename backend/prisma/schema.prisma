// Thảnh Thơi Farm CMS - Prisma Schema
// Multi-level categories, product variants, SEO, media

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())
  orders    Order[]
  reviews   Review[]
  wishlist  Wishlist[]
}


// ═══════════════════════════════════════
// CATEGORY SYSTEM (Multi-level, SEO)
// ═══════════════════════════════════════

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  imageUrl    String?
  parentId    Int?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  products    Product[]
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

// ═══════════════════════════════════════
// PRODUCT SYSTEM (SKU, Sale, SEO, Rich)
// ═══════════════════════════════════════

model Product {
  id            Int                @id @default(autoincrement())
  name          String
  slug          String             @unique
  sku           String?            @unique
  categoryId    Int?
  categoryRef   Category?          @relation(fields: [categoryId], references: [id])
  category      String             @default("")

  // Pricing
  price         Float
  salePrice     Float?
  oldPrice      Float?

  // Descriptions
  shortDesc     String?
  description   String?
  detailDesc    String?

  // Media
  images        ProductImage[]
  videoUrl      String?

  // SEO
  metaTitle     String?
  metaDesc      String?
  tags          String?

  // Stock & Status
  stock         Int                @default(100)
  allowPreorder Boolean            @default(false)
  prepDays      Int?
  isNew         Boolean            @default(false)
  badge         String?

  // Legacy (kept for compat)
  scent         String?
  size          String?
  use           String?
  rating        Float              @default(0)
  reviews       Int                @default(0)
  emoji         String?

  // Relations
  variants      Variant[]
  productAttrs  ProductAttribute[]
  reviews       Review[]
  wishlists     Wishlist[]

  createdAt     DateTime           @default(now())
}


model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  sortOrder Int     @default(0)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ═══════════════════════════════════════
// ATTRIBUTE & VARIANT SYSTEM
// ═══════════════════════════════════════

model Attribute {
  id             Int                @id @default(autoincrement())
  name           String             @unique
  values         AttributeValue[]
  productAttrs   ProductAttribute[]
  variantOptions VariantOption[]
}

model AttributeValue {
  id             Int             @id @default(autoincrement())
  value          String
  attributeId    Int
  attribute      Attribute       @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variantOptions VariantOption[]
}

model ProductAttribute {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId Int
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([productId, attributeId])
}

model Variant {
  id        Int             @id @default(autoincrement())
  productId Int
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String?
  price     Float?
  stock     Int             @default(0)
  imageUrl  String?
  options   VariantOption[]
}

model VariantOption {
  id          Int            @id @default(autoincrement())
  variantId   Int
  variant     Variant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeId Int
  attribute   Attribute      @relation(fields: [attributeId], references: [id])
  valueId     Int
  value       AttributeValue @relation(fields: [valueId], references: [id])

  @@unique([variantId, attributeId])
}

// ═══════════════════════════════════════
// ORDER & CONSULTATION
// ═══════════════════════════════════════

model Order {
  id            Int         @id @default(autoincrement())
  userId        Int?
  user          User?       @relation(fields: [userId], references: [id])
  
  // Normalized order items (thay thế JSON string)
  orderItems    OrderItem[]
  
  // Shipping info – fields rõ ràng thay vì JSON blob
  shipName      String?
  shipPhone     String?
  shipAddress   String?
  shipEmail     String?
  
  totalAmount   Float
  status        String      @default("pending")
  paymentMethod String      @default("cod")
  paymentStatus String      @default("unpaid")
  paymentId     String?
  
  // Legacy fields – giữ lại để backward compat, đánh dấu sẽ xóa sau
  items         String?     // @deprecated dùng orderItems
  shippingInfo  String?     // @deprecated dùng ship* fields
  
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id         Int     @id @default(autoincrement())
  orderId    Int
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  Int?    // nullable: sản phẩm có thể bị xóa sau này
  name       String
  price      Float
  qty        Int
  imageUrl   String?
  variantId  Int?
  variantLabel String?
}


model Consultation {
  id            Int      @id @default(autoincrement())
  userName      String
  phone         String
  category      String?
  skinType      String?
  householdSize String?
  frequency     String?
  note          String?
  status        String   @default("new")
  createdAt     DateTime @default(now())
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      @default(5)
  comment   String?
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Blog {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  summary     String?
  content     String
  imageUrl    String?
  author      String   @default("Thảnh Thơi Farm")
  tags        String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


