# ═══════════════════════════════════════
# CẤU HÌNH THẢNH THƠI FARM (PRODUCTION EXAMPLE)
# ═══════════════════════════════════════

# URL kết nối Database (Prisma)
# Ví dụ PostgreSQL: postgresql://user:password@localhost:5432/thanhthoi
DATABASE_URL="file:./dev.db"

# Khóa bí mật dùng để mã hóa Token (JWT) - Thay đổi chuỗi này để bảo mật!
JWT_SECRET="Thay_Doi_Chuoi_Nay_Ngau_Nhien_Tren_Production_2026"

# Chế độ chạy: production | development
NODE_ENV="production"

# Cổng chạy backend
PORT=5000

# Domain chính xác của frontend (để cấu hình CORS)
# Ví dụ: https://thanhthoi.farm
ALLOWED_ORIGIN="http://localhost:5000"

# Domain dùng cho các link tuyệt đối (nếu có)
DOMAIN="http://localhost:5000"
